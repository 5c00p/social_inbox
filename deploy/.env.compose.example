# --- Production compose-level variables ---
#
# This file becomes /opt/social_inbox/.env.compose on the VPS.
# It is used by docker compose for ${VAR} substitution at render time
# (Postgres container init, Traefik host labels, ACME email).
#
# It is NOT loaded into api/admin/worker containers — those use .env via
# `env_file: .env`, which Settings(extra="forbid") validates strictly.
# Keeping these vars out of .env avoids the strict-validation conflict.
#
# Used implicitly by all compose commands in deploy/scripts/* via
# `--env-file .env.compose`.
#
# After copying:
#   chmod 600 .env.compose && chown <deploy_user>:<deploy_user> .env.compose

# --- Postgres bootstrap (container init only) ---
# POSTGRES_PASSWORD MUST match the password embedded in POSTGRES_DSN in .env
POSTGRES_USER=social_inbox
POSTGRES_PASSWORD=<generate-strong-password>
POSTGRES_DB=social_inbox

# --- Traefik routing / ACME ---
PUBLIC_HOST_INBOX=inbox.your-domain.com
PUBLIC_HOST_ADMIN=inbox-admin.your-domain.com
TRAEFIK_ACME_EMAIL=victor@your-domain.com
