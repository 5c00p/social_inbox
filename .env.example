# --- Environment ---
ENV=dev
LOG_LEVEL=INFO

# --- Database ---
POSTGRES_DSN=postgresql://social_inbox:social_inbox@postgres:5432/social_inbox

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Messaging provider (active) ---
MESSAGING_PROVIDER=sendpulse

# --- SendPulse credentials ---
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_WEBHOOK_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6

# --- Internal API (shared with bot_purify) ---
INTERNAL_API_TOKEN=replace-me-with-long-random-string

# --- Admin ---
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=replace-me

# --- Monitoring ---
# Sentry: https://sentry.io/ — register, create project "social_inbox", get DSN
# Free tier (5k events/month) is enough for this scale
SENTRY_DSN=

# --- App URLs ---
PUBLIC_BASE_URL=http://localhost:8000
TELEGRAM_BOT_USERNAME=yuliya_purify_bot

# --- Notification bot (admin alerts) ---
# Same Telegram bot used by Task 14 (handover) + Task 16 (alerts/digest)
NOTIFICATION_BOT_TOKEN=
NOTIFICATION_ADMIN_CHAT_ID=

# --- Postgres container env (used by docker-compose for container init only, NOT loaded into app) ---
# Set these in docker-compose.yml environment section or as separate shell env vars.
# POSTGRES_USER=social_inbox
# POSTGRES_PASSWORD=social_inbox
# POSTGRES_DB=social_inbox
